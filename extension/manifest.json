{
  "manifest_version": 3,
  "name": "LyricSync",
  "version": "1.0.0",
  "description": "Line-by-line translations of the song you're playing on Spotify or Apple Music in Chrome, synced to the music. Free: translation runs on your computer.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open LyricSync",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://lrclib.net/*"],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*", "https://music.apple.com/*"],
      "js": ["content/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://open.spotify.com/*", "https://music.apple.com/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
