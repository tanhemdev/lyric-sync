# Translation function (api/translate.js)
ANTHROPIC_API_KEY=
# Optional: which Claude model translates (defaults to claude-haiku-5-5)
ANTHROPIC_MODEL=
# Only needed when the web app is hosted on a different origin, e.g. GitHub Pages
ALLOWED_ORIGINS=https://tanhemdev.github.io

# Web app build (web/build.mjs writes these into config.json)
LYRICSYNC_SPOTIFY_CLIENT_ID=
LYRICSYNC_TRANSLATE_URL=/api/translate
